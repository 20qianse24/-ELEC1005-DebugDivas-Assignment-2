                "InvariantScript": "\"[{\"\"Description\"\":\"\"Set up test case, set current user to an existing one and navigate to dashboard\"\",\"\"Rule\"\":\"\"Step1\"\",\"\"ScreenId\"\":\"\"95\"\"},{\"\"Description\"\":\"\"Confirm the group chat page is not visible before accepting an assignment\"\",\"\"Rule\"\":\"\"Step2\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Navigate to the first emergency assignment available (ID = 4) by default\"\",\"\"Rule\"\":\"\"Step3\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Accept assignment\"\",\"\"Rule\"\":\"\"Step4\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Check if groupchat page is now available/user has been added to group chat\"\",\"\"Rule\"\":\"\"Step5\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Navigate to groupchat page\"\",\"\"Rule\"\":\"\"Step6\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Send a message\"\",\"\"Rule\"\":\"\"Step7\"\",\"\"ScreenId\"\":\"\"179\"\"},{\"\"Description\"\":\"\"Confirm message was sent and saved\"\",\"\"Rule\"\":\"\"Step8\"\",\"\"ScreenId\"\":\"\"179\"\"}]\"",
