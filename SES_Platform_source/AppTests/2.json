                "InvariantScript": "\nAssert(!IsBlank(LookUp(Gallery1.AllItems, ID = newHazard.ID).Title));\nAssert(!IsBlank(LookUp(Gallery1.AllItems, ID = newHazard.ID).Severity.Value));\nAssert(!IsBlank(LookUp(Gallery1.AllItems, ID = newHazard.ID).Location));\nAssert(!IsBlank(LookUp(Gallery1.AllItems, ID = newHazard.ID).Description));",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step4",
                "Category": "Behavior",
                "InvariantScript": "\nSet(\n    newHazard,\n    Patch(\n        Hazards,\n        Defaults(Hazards),\n        {\n            Title: \"Test Hazard\",\n            Description: \"Test description\",\n            Severity: { Value: \"Low\" },\n            HazardType: { Value: \"Fire\" }\n        }\n    )\n);",
                "RuleProviderType": "Unknown"
              },
