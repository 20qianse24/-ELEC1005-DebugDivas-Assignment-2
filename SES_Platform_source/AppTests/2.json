              {
                "Property": "TestStepsMetadata",
                "Category": "Data",
                "InvariantScript": "\"[{\"\"Description\"\":\"\"Navigate(VolunteerDashboard);\"\",\"\"Rule\"\":\"\"Step1\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Set current user to existing user to mimick login\"\",\"\"Rule\"\":\"\"Step2\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Create a new hazard\"\",\"\"Rule\"\":\"\"Step4\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Check if new hazard appears on dashboard\"\",\"\"Rule\"\":\"\"Step5\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Check hazard required information is all displayed on dashboard\"\",\"\"Rule\"\":\"\"Step3\"\",\"\"ScreenId\"\":\"\"5\"\"}]\"",
