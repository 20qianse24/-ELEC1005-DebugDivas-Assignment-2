                "InvariantScript": "\"[{\"\"Description\"\":\"\"Navigate(VolunteerDashboard);\"\",\"\"Rule\"\":\"\"Step1\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Set(currentUserID, 2);\"\",\"\"Rule\"\":\"\"Step2\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Set(    selectedEmergency,    LookUp(Gallery1.AllItems, ID = 1));Navigate(EmergencyOverview);\"\",\"\"Rule\"\":\"\"Step3\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Accept assignment\"\",\"\"Rule\"\":\"\"Step4\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Decline assignmnet\"\",\"\"Rule\"\":\"\"Step5\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Confirm status is updated to declined\"\",\"\"Rule\"\":\"\"Step6\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Confirm assignment is no longer visible on dashboard\"\",\"\"Rule\"\":\"\"Step7\"\",\"\"ScreenId\"\":\"\"5\"\"}]\"",
