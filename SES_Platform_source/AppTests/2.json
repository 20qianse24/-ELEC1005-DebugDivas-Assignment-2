            "IsGroupControl": false,
            "IsAutoGenerated": false,
            "Rules": [
              {
                "Property": "DisplayName",
                "Category": "Data",
                "InvariantScript": "\"Expected Case - Receiving relevant assigments (based on relative qualifications)\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Description",
                "Category": "Data",
                "InvariantScript": "\"User only receives pending assignment on dahsboard if they hold at least 1 required qualification (Note: cannot allocate based on location due to platform limitations)\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "TestStepsMetadata",
                "Category": "Data",
                "InvariantScript": "\"[{\"\"Description\"\":\"\"Navigate to dashboard\"\",\"\"Rule\"\":\"\"Step1\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Set current user\"\",\"\"Rule\"\":\"\"Step2\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Create new emergency that does NOT match the current user 's qualification\"\",\"\"Rule\"\":\"\"Step3\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Check emergency is NOT displayed on current user's dashboard\"\",\"\"Rule\"\":\"\"Step4\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Check other visible assignments visible on dashboard match at least 1 qualification \"\",\"\"Rule\"\":\"\"Step5\"\",\"\"ScreenId\"\":\"\"5\"\"}]\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step1",
                "Category": "Behavior",
                "InvariantScript": "Navigate(VolunteerDashboard)",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step2",
                "Category": "Behavior",
                "InvariantScript": "Set(currentUserID, 3);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step3",
                "Category": "Behavior",
                "InvariantScript": "Set(\n    newEmergency,\n    Patch(\n        Emergencies,\n        Defaults(Emergencies),\n        {\n            Title: \"Test Emergency Skill 2\",\n            Description: \"Testing qualification matching\",\n            Severity: { Value: \"Medium\" },\n            EmergencyType: { Value: \"Fire\" },\n            Time: Now()\n        }\n    )\n);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step4",
                "Category": "Behavior",
                "InvariantScript": "\nAssert(\n    IsBlank(\n        LookUp(\n            Gallery1.AllItems,\n            ID = newEmergency.ID\n        )\n    ),\n    \"New emergency should not be displayed on dashboard for user without required qualification\"\n);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step5",
                "Category": "Behavior",
                "InvariantScript": "With(\n    {\n        userQuals: Filter(UserQualifications, UserId = currentUserID).QualificationId\n    },\n    Assert(\n        CountRows(\n            Filter(\n                Gallery1.AllItems As g,\n                IsEmpty(\n                    Filter(\n                        EmergencySkills,\n                        EmergencyId = g.ID &&\n                        QualificationId in userQuals\n                    )\n                )\n            )\n        ) = 0,\n        \"Some emergencies do not have at least one matching qualification\"\n    )\n)",
                "RuleProviderType": "Unknown"
              }
            ],
            "ControlPropertyState": [
              "DisplayName",
              "Description",
              "Step1",
              "TestStepsMetadata",
              "Step2",
              "Step3",
              "Step4",
              "Step5"
