            "IsFromScreenLayout": false,
            "StyleName": "",
            "Parent": "efb7368f-e696-48d6-a347-f8b1b37dde4c",
            "IsDataControl": true,
            "AllowAccessToGlobals": true,
            "OptimizeForDevices": "Off",
            "IsGroupControl": false,
            "IsAutoGenerated": false,
            "Rules": [
              {
                "Property": "DisplayName",
                "Category": "Data",
                "InvariantScript": "\"Expected Case - Accept Assignment\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Description",
                "Category": "Data",
                "InvariantScript": "\"Accept assignment and end shift to update hours\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "TestStepsMetadata",
                "Category": "Data",
                "InvariantScript": "\"[{\"\"Description\"\":\"\"Navigate to Volunteer Dashboard\"\",\"\"Rule\"\":\"\"Step1\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Set current user as an existing volunteer\"\",\"\"Rule\"\":\"\"Step2\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Select an emergency assignment (default to the 1st one)\"\",\"\"Rule\"\":\"\"Step3\"\",\"\"ScreenId\"\":\"\"5\"\"},{\"\"Description\"\":\"\"Verify task details are visible by checking title \"\",\"\"Rule\"\":\"\"Step5\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Tap Arrive on Scene and set intial worked hours\"\",\"\"Rule\"\":\"\"Step6\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"Verify status updated\"\",\"\"Rule\"\":\"\"Step4\"\",\"\"ScreenId\"\":\"\"55\"\"},{\"\"Description\"\":\"\"End shift\"\",\"\"Rule\"\":\"\"Step7\"\",\"\"ScreenId\"\":null},{\"\"Description\"\":\"\"Confirm the user's worked hours has been updated\"\",\"\"Rule\"\":\"\"Step8\"\",\"\"ScreenId\"\":null}]\"",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step1",
                "Category": "Behavior",
                "InvariantScript": "Navigate(VolunteerDashboard);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step2",
                "Category": "Behavior",
                "InvariantScript": "Set(currentUserID, 2);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step3",
                "Category": "Behavior",
                "InvariantScript": "Set(\n    selectedEmergency,\n    LookUp(Gallery1.AllItems, ID = 1)\n);\nNavigate(EmergencyOverview);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step4",
                "Category": "Behavior",
                "InvariantScript": "\nAssert(\n    LookUp(\n        AssignedUsers,\n        UserId = currentUserID &&\n        EmergencyId = selectedEmergency.ID\n    ).AUStatus.Value = \"Accepted\",\n    \"Status was not updated to Accepted\"\n);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step5",
                "Category": "Behavior",
                "InvariantScript": "\nAssert(\n    !IsBlank(Label4_1.Text),\n    \"Emergency title is not visible\"\n);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step6",
                "Category": "Behavior",
                "InvariantScript": "Set(\n    initialHours,\n    LookUp(Users, ID = currentUserID).HoursWorked\n);\nSelect(Timer1);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step7",
                "Category": "Behavior",
                "InvariantScript": "Select(Timer1);",
                "RuleProviderType": "Unknown"
              },
              {
                "Property": "Step8",
                "Category": "Behavior",
                "InvariantScript": "\nAssert(\n    LookUp(Users, ID = currentUserID).HoursWorked > initialHours,\n    \"Worked hours were not updated\"\n);",
                "RuleProviderType": "Unknown"
              }
            ],
            "ControlPropertyState": [
              "DisplayName",
              "Description",
              "Step1",
              "TestStepsMetadata",
              "Step2",
              "Step3",
              "Step4",
              "Step5",
              "Step6",
              "Step7",
              "Step8"
            ],
            "IsLocked": false,
            "ControlUniqueId": "339",
            "Children": []
          },
